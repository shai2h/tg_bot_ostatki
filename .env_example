DB_NAME=tg_bot_ostatki

MAX_TOKEN=
BOT_TOKEN=
BOT_RUN_MODE=polling

API_HOST=0.0.0.0
API_PORT=8000

ONE_C_STALE_AFTER_SECONDS=300
